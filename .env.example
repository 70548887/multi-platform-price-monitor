# Copy this file to .env and fill every secret, or run python scripts/init_env.py.
POSTGRES_USER=price_monitor
POSTGRES_DB=price_monitor
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin888
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=user123
SESSION_SECRET=
# Fernet key: URL-safe base64 encoding of 32 random bytes.
ENCRYPTION_KEY=
COOKIE_SECURE=false
WEB_BIND=127.0.0.1
WEB_PORT=28671

# ========== 服务端自更新配置 ==========
# Non-secret options: config/update.yaml. Credentials stay in the host environment.
UPDATE_GITHUB_TOKEN=
UPDATE_PROXY=
# Set to the host updater user's numeric UID/GID on Linux for the shared spool.
APP_UID=10001
APP_GID=10001

# Native development only; Compose sets internal addresses automatically.
# DATABASE_URL=postgresql+psycopg://price_monitor:YOUR_PASSWORD@127.0.0.1:5432/price_monitor
# REDIS_URL=redis://127.0.0.1:6379/0
